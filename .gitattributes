# 统一行尾，避免 Windows 上 core.autocrlf 把 shell 脚本存成 CRLF，
# 导致 Linux CI 报 "bad interpreter: /bin/sh^M: no such file or directory"
* text=auto eol=lf

# Gradle wrapper 的 shell 脚本必须是 LF
gradlew text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.jks binary
*.keystore binary
*.apk binary
